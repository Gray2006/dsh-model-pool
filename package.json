{
  "name": "dsh-model-pool",
  "version": "0.1.0",
  "description": "Quota-aware model failover for DeepSeek Harness: bench a route when it reports quota/auth failures and retry the same step on the next one in the pool.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./pool": "./lib/pool.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node --test test/pool.test.mjs test/host.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "failover",
    "quota",
    "llm",
    "routing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gray2006/dsh-model-pool.git"
  },
  "bugs": {
    "url": "https://github.com/Gray2006/dsh-model-pool/issues"
  },
  "homepage": "https://github.com/Gray2006/dsh-model-pool#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
