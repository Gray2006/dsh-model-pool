{
  "name": "dsh-model-pool",
  "version": "0.1.0",
  "description": "按额度自动换通道：一条通道报额度/鉴权失败就拉黑冷却，自动切到池里下一条可用的。挂在 agent/request 与 agent/request-error 两个宿主扩展点上。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./pool": "./lib/pool.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "test": "node --test test/pool.test.mjs test/host.test.mjs"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "model", "failover", "quota", "llm", "routing"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_NAME/dsh-model-pool.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_NAME/dsh-model-pool/issues"
  },
  "homepage": "https://github.com/YOUR_NAME/dsh-model-pool#readme",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web"
    }
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
